# Local-only dependency compose. Set a random value before using docker-compose.yml.
POSTGRES_PASSWORD=

# Independent Carelog runtime compose. Replace all example addresses and values.
CARELOG_IMAGE=carelog-be:local
CARELOG_BIND_ADDRESS=10.0.1.10
CARELOG_HTTP_PORT=8080
CARELOG_MANAGEMENT_HOST_PORT=19090
CARELOG_MEMORY_LIMIT=1g
CARELOG_ENVIRONMENT=production
CARELOG_SECRET_DIR=/etc/carelog/secrets
CARELOG_RDS_CA_FILE=/etc/carelog/rds-ca.pem
CARELOG_CORS_ALLOWED_ORIGINS=https://carelog.example.com
CARELOG_FLYWAY_ENABLED=false

SPRING_DATASOURCE_URL=jdbc:postgresql://replace-me.ap-northeast-2.rds.amazonaws.com:5432/carelog?sslmode=verify-full&sslrootcert=/run/rds-ca.pem
JWT_ACCESS_TOKEN_VALIDITY=900000
JWT_REFRESH_TOKEN_VALIDITY=2592000000
VALKEY_HOST=valkey.replace-me.internal
VALKEY_PORT=6379
VALKEY_TLS_ENABLED=true

# Optional Hikari and Lettuce bounds. Match these to RDS and Valkey capacity.
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
VALKEY_TIMEOUT=3s
VALKEY_CONNECT_TIMEOUT=3s
